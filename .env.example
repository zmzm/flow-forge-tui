# FlowForge configuration (copy to .env and fill in real values).
# .env is gitignored — never commit secrets.

# Required: target repository and task queue (used by both the TUI and the
# headless runner). PROJECT_DIR is the cwd for opencode; TASKS_FILE is the
# tasks.jsonl queue; steps.json is expected next to TASKS_FILE.
PROJECT_DIR=/home/USER/projects/my-project
TASKS_FILE=/home/USER/projects/my-project/tasks.jsonl

# OpenCode executable. Optional; defaults to "opencode" from PATH.
# For systemd (which does not read ~/.bashrc), set an absolute path, e.g.:
# OPENCODE_BIN=/home/USER/.local/bin/opencode
OPENCODE_BIN=

# Batch execution (headless runner)
# Max tasks processed per invocation (default 1 = legacy behavior).
FLOWFORGE_MAX_TASKS_PER_RUN=1
# Stop the batch when a task fails (true/false).
FLOWFORGE_STOP_ON_FAILURE=true
# Do not start another task after this many seconds (0 = unlimited). A task
# already in flight is never killed because of this limit.
FLOWFORGE_MAX_RUNTIME_SECONDS=14400

# Matrix notifications (infrastructure-level observability).
MATRIX_ENABLED=false
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_ROOM_ID=
MATRIX_ACCESS_TOKEN=
# Optional HTTP timeout for Matrix requests in seconds (default 10).
MATRIX_TIMEOUT_SECONDS=10
